{
  "description": "Planning with Files lifecycle integration for Claude Code",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "statusMessage": "Restoring planning context",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.sh\" session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.sh\" user-prompt-submit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|Read|Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.sh\" pre-tool-use"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.sh\" post-tool-use"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.sh\" pre-compact"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "statusMessage": "Checking planning completion",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/claude-hook.sh\" stop"
          }
        ]
      }
    ]
  }
}
